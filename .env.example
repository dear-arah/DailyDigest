# Copy this file to .env and fill in the values. .env is ignored by git and never committed.
# The same three names are used as repository secrets in GitHub Actions
# (Settings > Secrets and variables > Actions).

# Discord: channel settings > Integrations > Webhooks > Copy Webhook URL
DISCORD_WEBHOOK_URL=

# Free key from Google AI Studio (create it in a project without billing)
GEMINI_API_KEY=

# Free key from the Groq console (fallback provider)
GROQ_API_KEY=
